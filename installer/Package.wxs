<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
   <Package Name="QQQ Print Agent" Manufacturer="QRun-IO" Version="$(ProductVersion)"
            UpgradeCode="D761CD03-F616-4C98-9A94-9F590A36E449" Scope="perMachine" InstallerVersion="500">
      <!-- Execute the protected-state preflight before removing the previous product.
           Deferred actions are queued until InstallExecute, not run at their table slot.
           Stable component GUIDs preserve shared files/service during old-product removal. -->
      <MajorUpgrade AllowSameVersionUpgrades="yes" Schedule="afterInstallExecute" DowngradeErrorMessage="A newer print connector is already installed." />
      <MediaTemplate EmbedCab="yes" CompressionLevel="high" />
      <Property Id="BRANDNAME" Secure="yes" />
      <Property Id="BRANDCOMPANY" Secure="yes" />
      <Property Id="STORED_BRAND_NAME">
         <RegistrySearch Id="FindBrandName" Root="HKLM" Key="SOFTWARE\QRunIO\PrintAgent" Name="DisplayName" Type="raw" Bitness="always64" />
      </Property>
      <Property Id="STORED_BRAND_COMPANY">
         <RegistrySearch Id="FindBrandCompany" Root="HKLM" Key="SOFTWARE\QRunIO\PrintAgent" Name="CompanyName" Type="raw" Bitness="always64" />
      </Property>
      <SetProperty Id="BRANDNAME" Action="UseStoredBrandName" Value="[STORED_BRAND_NAME]" After="AppSearch" Condition="NOT BRANDNAME AND STORED_BRAND_NAME" />
      <SetProperty Id="BRANDNAME" Action="UseDefaultBrandName" Value="QQQ Print Agent" After="UseStoredBrandName" Condition="NOT BRANDNAME" />
      <SetProperty Id="BRANDCOMPANY" Action="UseStoredBrandCompany" Value="[STORED_BRAND_COMPANY]" After="UseDefaultBrandName" Condition="NOT BRANDCOMPANY AND STORED_BRAND_COMPANY" />
      <SetProperty Id="BRANDCOMPANY" Action="UseDefaultBrandCompany" Value="QRun-IO" After="UseStoredBrandCompany" Condition="NOT BRANDCOMPANY" />
      <SetProperty Id="ProductName" Action="SetBrandedProductName" Value="[BRANDNAME]" After="UseDefaultBrandCompany" />
      <SetProperty Id="Manufacturer" Action="SetBrandedManufacturer" Value="[BRANDCOMPANY]" After="SetBrandedProductName" />
      <CustomAction Id="ValidateMachineStateBeforeFolders" Directory="System64Folder" ExeCommand="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -Command &quot;$ErrorActionPreference=&apos;Stop&apos;; $trusted=@(&apos;S-1-5-18&apos;,&apos;S-1-5-32-544&apos;,&apos;S-1-5-80-956008885-3418522649-1831038044-1853292631-2271478464&apos;); function AssertNode([\[]string[\]]$p) [\{] $i=Get-Item -LiteralPath $p -Force; if($i.Attributes -band [\[]IO.FileAttributes[\]]::ReparsePoint) [\{] throw &apos;Machine print state contains a link. Installation refused.&apos; [\}]; $a=$i.GetAccessControl(); if($a.GetOwner([\[]Security.Principal.SecurityIdentifier[\]]).Value -notin $trusted) [\{] throw &apos;Machine print state has an untrusted owner. Installation refused.&apos; [\}]; $raw=[\[]Security.AccessControl.RawSecurityDescriptor[\]]::new($a.GetSecurityDescriptorBinaryForm(),0); if($null -eq $raw.DiscretionaryAcl) [\{] throw &apos;Machine print state has no ACL.&apos; [\}]; foreach($r in $a.GetAccessRules($true,$true,[\[]Security.Principal.SecurityIdentifier[\]])) [\{] if($r.AccessControlType -eq &apos;Allow&apos; -and [\[]int[\]]$r.FileSystemRights -ne 0 -and $r.IdentityReference.Value -notin $trusted) [\{] throw &apos;Machine print state permits untrusted access. Installation refused.&apos; [\}] [\}]; if($i.PSIsContainer) [\{] foreach($c in [\[]IO.Directory[\]]::EnumerateFileSystemEntries($p)) [\{] AssertNode $c [\}] [\}] [\}]; try [\{] $root=Join-Path ([\[]Environment[\]]::GetFolderPath(&apos;CommonApplicationData&apos;)) &apos;QqqPrintAgent&apos;; for($p=$root;$p;$p=[\[]IO.Path[\]]::GetDirectoryName($p)) [\{] if(Test-Path -LiteralPath $p) [\{] if((Get-Item -LiteralPath $p -Force).Attributes -band [\[]IO.FileAttributes[\]]::ReparsePoint) [\{] throw &apos;Machine print state path contains a link.&apos; [\}] [\}] [\}]; if(-not [\[]IO.Directory[\]]::Exists($root)) [\{] $acl=[\[]Security.AccessControl.DirectorySecurity[\]]::new(); $acl.SetSecurityDescriptorSddlForm(&apos;O:SYG:SYD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)&apos;); [\[]IO.DirectoryInfo[\]]::new($root).Create($acl) [\}]; AssertNode $root; exit 0 [\}] catch [\{] [\[]Console[\]]::Error.WriteLine($_.Exception.Message); exit 1 [\}]&quot;" Execute="deferred" Impersonate="no" Return="check" />
      <CustomAction Id="ValidateMachineStateAfterFiles" FileRef="ServiceExe" ExeCommand="--validate-machine-state" Execute="deferred" Impersonate="no" Return="check" />
      <CustomAction Id="RemoveStartupTasks" FileRef="ServiceExe" ExeCommand="--remove-startup-tasks" Execute="deferred" Impersonate="no" Return="check" />
      <CustomAction Id="ApplyBranding" FileRef="ServiceExe" ExeCommand="--apply-branding" Execute="deferred" Impersonate="no" Return="check" />
      <CustomAction Id="RemoveBrandingShortcut" FileRef="ServiceExe" ExeCommand="--remove-branding-shortcut" Execute="deferred" Impersonate="no" Return="check" />
      <InstallExecuteSequence>
         <InstallExecute Sequence="6500" />
         <Custom Action="ValidateMachineStateBeforeFolders" Before="CreateFolders" Condition="NOT REMOVE~=&quot;ALL&quot;" />
         <Custom Action="ValidateMachineStateAfterFiles" After="InstallFiles" Condition="NOT REMOVE~=&quot;ALL&quot;" />
         <Custom Action="RemoveStartupTasks" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
         <Custom Action="ApplyBranding" After="WriteRegistryValues" Condition="NOT REMOVE~=&quot;ALL&quot;" />
         <Custom Action="RemoveBrandingShortcut" Before="RemoveRegistryValues" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      </InstallExecuteSequence>

      <StandardDirectory Id="ProgramFiles64Folder">
         <Directory Id="INSTALLFOLDER" Name="QQQ Print Agent">
            <Directory Id="SERVICEDIR" Name="Service">
               <Component Id="PrintService" Guid="8B5BA126-43F2-4F8D-91E5-8B9A5989D8BD" Bitness="always64">
                  <File Id="ServiceExe" Source="$(PayloadRoot)\service\Qqq.PrintAgent.Service.exe" KeyPath="yes" />
                  <ServiceInstall Id="InstallPrintService" Name="QqqPrintAgent" DisplayName="[BRANDNAME]"
                                  Description="Connects outbound to the print server and prints assigned documents using local Windows printer queues."
                                  Type="ownProcess" Start="auto" ErrorControl="normal" Account="LocalSystem" Vital="yes">
                     <ServiceDependency Id="Spooler" />
                     <util:ServiceConfig FirstFailureActionType="restart" SecondFailureActionType="restart"
                                         ThirdFailureActionType="none" RestartServiceDelayInSeconds="30" ResetPeriodInDays="1" />
                  </ServiceInstall>
                  <ServiceControl Id="ControlPrintService" Name="QqqPrintAgent" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
               </Component>
               <Files Include="$(PayloadRoot)\service\**">
                  <Exclude Files="$(PayloadRoot)\service\Qqq.PrintAgent.Service.exe" />
                  <Exclude Files="$(PayloadRoot)\service\**.pdb" />
               </Files>
            </Directory>
            <Directory Id="APPDIR" Name="App">
               <Component Id="AgentCompanion" Guid="2FD52718-B33B-42AA-9E28-21B3B70FA4BB" Bitness="always64">
                  <File Id="CompanionExe" Source="$(PayloadRoot)\app\Qqq.PrintAgent.exe" KeyPath="yes" />
               </Component>
               <Files Include="$(PayloadRoot)\app\**">
                  <Exclude Files="$(PayloadRoot)\app\Qqq.PrintAgent.exe" />
                  <Exclude Files="$(PayloadRoot)\app\**.pdb" />
               </Files>
            </Directory>
            <Directory Id="CLIDIR" Name="Cli">
               <Files Include="$(PayloadRoot)\cli\**">
                  <Exclude Files="$(PayloadRoot)\cli\**.pdb" />
               </Files>
            </Directory>
         </Directory>
      </StandardDirectory>

      <StandardDirectory Id="CommonAppDataFolder">
         <Directory Id="DATADIR" Name="QqqPrintAgent">
            <!-- The journal must survive upgrades and uninstall/reinstall to avoid duplicate prints. -->
            <Component Id="ProtectedAgentData" Guid="55147A95-1D16-452D-BF75-1F3834867D07" Permanent="yes" Bitness="always64">
               <CreateFolder>
                  <PermissionEx Sddl="O:SYG:SYD:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" />
               </CreateFolder>
               <RegistryValue Root="HKLM" Key="SOFTWARE\QRunIO\PrintAgent" Name="DisplayName" Type="string" Value="[BRANDNAME]" />
               <RegistryValue Root="HKLM" Key="SOFTWARE\QRunIO\PrintAgent" Name="CompanyName" Type="string" Value="[BRANDCOMPANY]" />
            </Component>
         </Directory>
      </StandardDirectory>

   </Package>
</Wix>
