<Project Sdk="WixToolset.Sdk/6.0.2">
   <PropertyGroup>
      <OutputType>Package</OutputType>
      <InstallerPlatform>x64</InstallerPlatform>
      <ProductVersion Condition="'$(ProductVersion)' == ''">0.1.6</ProductVersion>
      <PayloadRoot Condition="'$(PayloadRoot)' == ''">$(MSBuildThisFileDirectory)..\artifacts\package</PayloadRoot>
      <OutputName>QqqPrintAgent-$(ProductVersion)-x64</OutputName>
      <DefineConstants>ProductVersion=$(ProductVersion);PayloadRoot=$(PayloadRoot)</DefineConstants>
      <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
      <!-- Bundled Microsoft WinUI DLLs contain multi-language version resources exceeding
           ICE03's Language-column limit, and newer MUI LCIDs absent from its static list.
           Keep those signed vendor files unchanged. ICE61 conflicts with our explicit
           same-core RC-to-RC/stable major upgrade policy; the app enforces newer SemVer.
           Manual MSI deployment must follow release order. Retain all other ICE checks. -->
      <SuppressIces>ICE03;ICE61</SuppressIces>
   </PropertyGroup>
   <ItemGroup>
      <PackageReference Include="WixToolset.Util.wixext" />
   </ItemGroup>
</Project>
