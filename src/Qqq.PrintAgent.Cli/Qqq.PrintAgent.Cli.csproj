<Project Sdk="Microsoft.NET.Sdk">

   <!-- The scriptable head over the same Core as the window. Ships as a self-contained
        single-file exe named after the app id (qqq-print-agent.exe), so the coverage package
        name is the assembly name, not the project name. -->
   <PropertyGroup>
      <OutputType>Exe</OutputType>
      <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
      <AssemblyName>qqq-print-agent</AssemblyName>
      <RootNamespace>Qqq.PrintAgent.Cli</RootNamespace>
      <InvariantGlobalization>true</InvariantGlobalization>
      <ApplicationIcon>..\Qqq.PrintAgent\Assets\Brand\app.ico</ApplicationIcon>
   </PropertyGroup>

   <ItemGroup>
      <ProjectReference Include="..\Qqq.PrintAgent.Core\Qqq.PrintAgent.Core.csproj" />
   </ItemGroup>

   <ItemGroup>
      <InternalsVisibleTo Include="Qqq.PrintAgent.Cli.Tests" />
   </ItemGroup>

   <ItemGroup>
      <!-- The app's own namespaces are global usings: their sort position against other
           usings depends on the app's name, which the template replaces. -->
      <Using Include="Qqq.PrintAgent.Core" />
      
   </ItemGroup>

<ItemGroup><ProjectReference Include="../Qqq.PrintAgent.Windows/Qqq.PrintAgent.Windows.csproj" /></ItemGroup></Project>


