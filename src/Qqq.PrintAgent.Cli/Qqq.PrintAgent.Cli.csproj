<Project Sdk="Microsoft.NET.Sdk">

   <!-- The command-line client of the installed service. It reaches the service through the
        Windows layer's pipe client and holds no protocol or printing logic of its own, so it
        references only that layer. The executable is named after the app id
        (qqq-print-agent.exe), so the coverage package name is the assembly name, not the
        project name. The installer publishes it self-contained for win-x64. -->
   <PropertyGroup>
      <OutputType>Exe</OutputType>
      <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
      <AssemblyName>qqq-print-agent</AssemblyName>
      <RootNamespace>Qqq.PrintAgent.Cli</RootNamespace>
      <InvariantGlobalization>true</InvariantGlobalization>
      <ApplicationIcon>..\Qqq.PrintAgent\Assets\Brand\app.ico</ApplicationIcon>
   </PropertyGroup>

   <ItemGroup>
      <ProjectReference Include="..\Qqq.PrintAgent.Windows\Qqq.PrintAgent.Windows.csproj" />
   </ItemGroup>

   <ItemGroup>
      <InternalsVisibleTo Include="Qqq.PrintAgent.Cli.Tests" />
   </ItemGroup>

</Project>
