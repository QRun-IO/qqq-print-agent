<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Qqq.PrintAgent.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
   <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
   <Grid x:Name="RootGrid" Loaded="Root_Loaded" KeyboardAcceleratorPlacementMode="Hidden">
      <Grid.KeyboardAccelerators>
         <KeyboardAccelerator Key="S" Modifiers="Control,Shift" Invoked="SettingsAccelerator_Invoked" />
         <KeyboardAccelerator Key="L" Modifiers="Control,Shift" Invoked="LogsAccelerator_Invoked" />
      </Grid.KeyboardAccelerators>
      <Grid.Resources>
         <Style x:Key="FullWidthListItem" TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="8,0" /></Style>
      </Grid.Resources>
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <NavigationView x:Name="Navigation" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" OpenPaneLength="210" CompactPaneLength="48" SelectionChanged="Navigation_SelectionChanged">
         <NavigationView.PaneHeader><TextBlock x:Name="ProductHeading" Text="QQQ Print Agent" FontSize="16" FontWeight="SemiBold" Margin="16,8,12,16" TextWrapping="Wrap" /></NavigationView.PaneHeader>
         <NavigationView.MenuItems>
            <NavigationViewItem x:Name="PrintersNavigation" Content="Printers" Tag="Printers" AccessKey="P" AutomationProperties.AutomationId="NavigatePrinters"><NavigationViewItem.Icon><SymbolIcon Symbol="Print" /></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem x:Name="JobsNavigation" Content="Jobs" Tag="Jobs" AccessKey="J" AutomationProperties.AutomationId="NavigateJobs"><NavigationViewItem.Icon><SymbolIcon Symbol="Document" /></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem x:Name="LogsNavigation" Content="Logs" Tag="Logs" AccessKey="L" ToolTipService.ToolTip="Logs (Ctrl+Shift+L)" AutomationProperties.AutomationId="NavigateLogs"><NavigationViewItem.Icon><SymbolIcon Symbol="List" /></NavigationViewItem.Icon></NavigationViewItem>
         </NavigationView.MenuItems>
         <Grid Padding="28,20,28,16" RowSpacing="16">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="16">
               <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
               <StackPanel Spacing="4"><TextBlock x:Name="PageTitle" Text="Printers" Style="{ThemeResource TitleTextBlockStyle}" /><TextBlock x:Name="PageDescription" Text="Choose which printers this computer shares with QQQ." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
               <Button x:Name="RefreshButton" Grid.Column="1" Click="Refresh_Click" AutomationProperties.AutomationId="RefreshStatus" VerticalAlignment="Center" ToolTipService.ToolTip="Refresh device status"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Refresh" /><TextBlock Text="Refresh" /></StackPanel></Button>
            </Grid>
            <InfoBar AutomationProperties.LiveSetting="Polite" x:Name="FeedbackBar" Grid.Row="1" IsOpen="False" IsClosable="True" />
            <Grid Grid.Row="2">
               <Grid x:Name="PrintersPage" RowSpacing="12">
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="PrintersSummary" Text="Waiting for the local print service" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Windows printer settings" Click="PrinterSettings_Click" AutomationProperties.AutomationId="WindowsPrinterSettings" /></Grid>
                  <ListView x:Name="PrintersList" Grid.Row="1" ItemContainerStyle="{StaticResource FullWidthListItem}" SelectionMode="None" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="PrinterInventory" />
                  <StackPanel x:Name="PrintersEmpty" Grid.Row="1" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="350"><FontIcon Glyph="&#xE749;" FontSize="40" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="Your printers will appear here" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" /><TextBlock x:Name="PrintersEmptyText" Text="Install and start the local print service to discover this computer’s printers." TextAlignment="Center" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Button Content="Connection settings" Click="Connection_Click" HorizontalAlignment="Center" /></StackPanel>
                  <TextBlock Grid.Row="2" Text="Shared printers also need approval in QQQ before jobs can be sent." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" FontSize="12" />
               </Grid>
               <Grid x:Name="JobsPage" Visibility="Collapsed" RowSpacing="12">
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <StackPanel Spacing="12"><Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="JobSearch" AutomationProperties.AutomationId="JobSearch" PlaceholderText="Search jobs, documents or printers" AutomationProperties.Name="Search print jobs" TextChanged="JobFilters_Changed" /><ComboBox x:Name="JobStatusFilter" AutomationProperties.AutomationId="JobStatusFilter" Grid.Column="1" MinWidth="160" SelectedIndex="0" SelectionChanged="JobFilters_Changed" AutomationProperties.Name="Filter jobs by status"><ComboBoxItem Content="All jobs" Tag="ALL" /><ComboBoxItem Content="Needs attention" Tag="ATTENTION" /><ComboBoxItem Content="In progress" Tag="ACTIVE" /><ComboBoxItem Content="Sent to printer" Tag="SPOOLED" /></ComboBox></Grid><TextBlock x:Name="JobsSummary" AutomationProperties.AutomationId="JobsSummary" Text="No local print jobs yet" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                  <ListView x:Name="JobsList" Grid.Row="1" ItemContainerStyle="{StaticResource FullWidthListItem}" SelectionMode="None" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="RecentJobs" />
                  <StackPanel x:Name="JobsEmpty" Grid.Row="1" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="350"><SymbolIcon Symbol="Document" /><TextBlock x:Name="JobsEmptyTitle" Text="No jobs yet" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" /><TextBlock x:Name="JobsEmptyMessage" Text="Jobs sent from QQQ appear here once the service receives them." TextWrapping="Wrap" TextAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel>
                  <TextBlock Grid.Row="2" Text="Sent to printer means Windows accepted the job. Check the printer to confirm physical output." FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
               </Grid>
               <StackPanel x:Name="LogsPage" Visibility="Collapsed" Spacing="16" MaxWidth="580" HorizontalAlignment="Left">
                  <TextBlock Text="Service and companion events are available together in the AppKit activity log." TextWrapping="Wrap" />
                  <Button Content="Open activity log" Click="ActivityLog_Click" AutomationProperties.AutomationId="ActivityLogMenuItem"><Button.Style><StaticResource ResourceKey="AccentButtonStyle" /></Button.Style></Button>
                  <TextBlock Text="Follow live updates, show errors only, copy entries or open the logs folder using the viewer’s toolbar." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
               </StackPanel>
               <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                  <StackPanel Spacing="24" MaxWidth="680" HorizontalAlignment="Left">
                     <StackPanel Spacing="10">
                        <TextBlock Text="Windows service" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="ServiceStateText" Text="Checking service installation…" />
                        <TextBlock x:Name="ServiceGuidanceText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="StartServiceButton" AutomationProperties.AutomationId="StartService" Content="Start service" Click="StartService_Click" IsEnabled="False" /><Button x:Name="RestartServiceButton" AutomationProperties.AutomationId="RestartService" Content="Restart service" Click="RestartService_Click" IsEnabled="False" /><Button Content="Windows Services" Click="Services_Click" /></StackPanel>
                        <HyperlinkButton Content="Get the installer" NavigateUri="https://github.com/QRun-IO/qqq-print-agent/releases" Padding="0" />
                     </StackPanel>
                     <StackPanel Spacing="10"><TextBlock Text="QQQ connection" Style="{ThemeResource SubtitleTextBlockStyle}" /><TextBlock x:Name="StatusText" Text="Waiting for service status" TextWrapping="Wrap" AutomationProperties.AutomationId="ServiceStatus" /><TextBlock x:Name="ConnectionText" Text="Connect this computer to your QQQ server." TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Button x:Name="ConnectionButton" Content="Connection settings" Click="Connection_Click" AutomationProperties.AutomationId="ConnectionSettings" /></StackPanel>
                     <StackPanel Spacing="12"><TextBlock Text="Appearance" Style="{ThemeResource SubtitleTextBlockStyle}" /><ComboBox x:Name="ThemeChoice" Header="App theme" MinWidth="220" SelectionChanged="Theme_SelectionChanged"><ComboBoxItem Content="Use Windows setting" Tag="System" /><ComboBoxItem Content="Light" Tag="Light" /><ComboBoxItem Content="Dark" Tag="Dark" AutomationProperties.AutomationId="ThemeDark" /></ComboBox><ToggleSwitch x:Name="SplashToggle" Header="Show splash screen at startup" Toggled="Splash_Toggled" AutomationProperties.AutomationId="SplashAtStartup" /><NumberBox x:Name="SplashDuration" Header="Splash duration (milliseconds)" SpinButtonPlacementMode="Inline" SmallChange="500" LargeChange="1000" ValueChanged="SplashDuration_ValueChanged" AutomationProperties.AutomationId="SplashDuration" MinWidth="220" HorizontalAlignment="Left" /></StackPanel>
                     <StackPanel Spacing="10">
                        <TextBlock Text="Updates" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="VersionText" AutomationProperties.AutomationId="InstalledVersion" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="UpdateChannelText" AutomationProperties.AutomationId="UpdateChannel" />
                        <ToggleSwitch x:Name="UpdateStartupToggle" Header="Check for updates when the companion starts" Toggled="UpdateStartup_Toggled" AutomationProperties.AutomationId="CheckUpdatesAtStartup" />
                        <Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="CheckUpdates_Click" AutomationProperties.AutomationId="CheckForUpdates" AccessKey="U" />
                        <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="LastUpdateOutcomeText" Visibility="Collapsed" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="LastUpdateOutcome" AutomationProperties.LiveSetting="Polite" />
                        <HyperlinkButton Content="Release notes and downloads" NavigateUri="https://github.com/QRun-IO/qqq-print-agent/releases" Padding="0" AutomationProperties.AutomationId="ReleaseNotes" />
                     </StackPanel>
                     <StackPanel Spacing="10"><TextBlock Text="About and help" Style="{ThemeResource SubtitleTextBlockStyle}" /><Image x:Name="CustomerLogo" Visibility="Collapsed" Width="128" Height="64" Stretch="Uniform" HorizontalAlignment="Left" /><TextBlock x:Name="CompanyHeading" Visibility="Collapsed" TextWrapping="Wrap" /><HyperlinkButton x:Name="SupportLink" Content="Contact support" Visibility="Collapsed" Padding="0" /><Button x:Name="AboutButton" Content="About QQQ Print Agent" Click="About_Click" AutomationProperties.AutomationId="AboutMenuItem" /><HyperlinkButton Content="User guide" NavigateUri="https://github.com/QRun-IO/qqq-print-agent/blob/main/docs/USER-GUIDE.md" Padding="0" AutomationProperties.AutomationId="UserGuide" /><HyperlinkButton Content="Report an issue" NavigateUri="https://github.com/QRun-IO/qqq-print-agent/issues/new/choose" Padding="0" AutomationProperties.AutomationId="ReportIssue" /><HyperlinkButton Content="Project on GitHub" NavigateUri="https://github.com/QRun-IO/qqq-print-agent" Padding="0" AutomationProperties.AutomationId="ProjectLink" /></StackPanel>
                     <StackPanel Spacing="10"><TextBlock Text="Background printing" Style="{ThemeResource SubtitleTextBlockStyle}" /><ToggleSwitch x:Name="StartupToggle" Header="Show the tray companion when I sign in" IsEnabled="False" Toggled="Startup_Toggled" AutomationProperties.AutomationId="StartupAtSignIn" /><TextBlock x:Name="StartupGuidanceText" Text="Startup is off until you enable it for an installed copy." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="Closing this window keeps the companion in your tray. Printing continues in the Windows service, even when you exit the companion." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Button Content="Exit companion" Click="Exit_Click" /></StackPanel>
                  </StackPanel>
               </ScrollViewer>
            </Grid>
         </Grid>
      </NavigationView>
      <Border Grid.Row="1" Padding="20,10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
         <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Ellipse x:Name="FooterDot" Width="10" Height="10" Fill="Red" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock x:Name="FooterStatus" Text="Checking local service…" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="FooterStatus" AutomationProperties.LiveSetting="Polite" /><TextBlock x:Name="FooterContact" Text="Status refreshes every 5 seconds" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button x:Name="ReconnectButton" Content="Reconnect" Click="Reconnect_Click" AutomationProperties.AutomationId="ReconnectDevice" /><Button Content="View logs" Click="ServiceLogs_Click" AutomationProperties.AutomationId="ViewServiceLogs" /></StackPanel></Grid>
      </Border>
      <ContentDialog x:Name="ConnectionDialog" Title="Connection settings" CloseButtonText="Close">
         <StackPanel Spacing="12"><TextBlock Text="In QQQ, open Printing → Print devices → Actions → Enroll a print device. Enter the server address and the single-use enrollment code below." TextWrapping="Wrap" /><TextBox x:Name="ServerBox" Header="QQQ server address" PlaceholderText="https://qqq.example.com" AutomationProperties.AutomationId="ServerAddress" /><PasswordBox x:Name="EnrollmentBox" Header="Enrollment code" PlaceholderText="Paste the code from QQQ" AutomationProperties.AutomationId="EnrollmentCode" /><Button x:Name="EnrollButton" Content="Connect this device" Click="Enroll_Click" Style="{ThemeResource AccentButtonStyle}" AutomationProperties.AutomationId="EnrollDevice" /><InfoBar x:Name="ConnectionFeedback" IsOpen="False" IsClosable="False" /></StackPanel>
      </ContentDialog>
   </Grid>
</Window>
