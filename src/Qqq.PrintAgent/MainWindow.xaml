<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Qqq.PrintAgent.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
   <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
   <Grid x:Name="RootGrid" Loaded="Root_Loaded" KeyboardAcceleratorPlacementMode="Hidden">
      <Grid.KeyboardAccelerators>
         <KeyboardAccelerator Key="S" Modifiers="Control,Shift" Invoked="SettingsAccelerator_Invoked" />
         <KeyboardAccelerator Key="L" Modifiers="Control,Shift" Invoked="LogsAccelerator_Invoked" />
      </Grid.KeyboardAccelerators>
      <Grid.Resources>
         <Style x:Key="TableHeaderButton" TargetType="Button"><Setter Property="Padding" Value="0,6" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /></Style>
         <Style x:Key="FullWidthListItem" TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="8,0" /></Style>
      </Grid.Resources>
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <MenuBar AutomationProperties.AutomationId="AppMenuBar">
         <MenuBarItem Title="File" AccessKey="F" AutomationProperties.AutomationId="FileMenu">
            <MenuFlyoutItem Text="Settings" Click="SettingsMenu_Click" AutomationProperties.AutomationId="SettingsMenuItem" KeyboardAcceleratorTextOverride="Ctrl+Shift+S" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="Close window" Click="CloseDetailsMenu_Click" AutomationProperties.AutomationId="CloseWindowMenuItem" ToolTipService.ToolTip="Hide details in the system tray; printing continues">
               <MenuFlyoutItem.KeyboardAccelerators><KeyboardAccelerator Key="W" Modifiers="Control" /></MenuFlyoutItem.KeyboardAccelerators>
            </MenuFlyoutItem>
            <MenuFlyoutItem Text="Exit companion" Click="Exit_Click" AutomationProperties.AutomationId="ExitMenuItem" />
         </MenuBarItem>
         <MenuBarItem Title="Help" AccessKey="H" AutomationProperties.AutomationId="HelpMenu">
            <MenuFlyoutItem Text="Activity log" Click="ActivityLog_Click" AutomationProperties.AutomationId="ActivityLogHelpMenuItem" KeyboardAcceleratorTextOverride="Ctrl+Shift+L" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem Text="User guide" Tag="https://github.com/QRun-IO/qqq-print-agent/blob/main/docs/USER-GUIDE.md" Click="HelpLinkMenu_Click" AutomationProperties.AutomationId="UserGuideMenuItem" />
            <MenuFlyoutItem Text="Contact support" Click="SupportMenu_Click" AutomationProperties.AutomationId="SupportMenuItem" />
            <MenuFlyoutItem Text="Release notes and downloads" Tag="https://github.com/QRun-IO/qqq-print-agent/releases" Click="HelpLinkMenu_Click" AutomationProperties.AutomationId="ReleaseNotesMenuItem" />
            <MenuFlyoutItem Text="Project on GitHub" Tag="https://github.com/QRun-IO/qqq-print-agent" Click="HelpLinkMenu_Click" AutomationProperties.AutomationId="ProjectMenuItem" />
            <MenuFlyoutSeparator />
            <MenuFlyoutItem x:Name="CheckUpdatesMenuItem" Text="Check for updates" Click="CheckUpdates_Click" AutomationProperties.AutomationId="CheckUpdatesMenuItem" IsEnabled="False" />
            <MenuFlyoutItem Text="About" Click="About_Click" AutomationProperties.AutomationId="AboutHelpMenuItem" />
         </MenuBarItem>
      </MenuBar>
      <NavigationView x:Name="Navigation" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed" IsSettingsVisible="True" OpenPaneLength="210" CompactPaneLength="48" SelectionChanged="Navigation_SelectionChanged">
         <NavigationView.PaneHeader><TextBlock x:Name="ProductHeading" Text="Print Agent" FontSize="16" FontWeight="SemiBold" Margin="16,8,12,16" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" /></NavigationView.PaneHeader>
         <NavigationView.MenuItems>
            <NavigationViewItem x:Name="PrintersNavigation" Content="Printers" Tag="Printers" AccessKey="P" AutomationProperties.AutomationId="NavigatePrinters"><NavigationViewItem.Icon><SymbolIcon Symbol="Print" /></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem x:Name="JobsNavigation" Content="Jobs" Tag="Jobs" AccessKey="J" AutomationProperties.AutomationId="NavigateJobs"><NavigationViewItem.Icon><SymbolIcon Symbol="Document" /></NavigationViewItem.Icon></NavigationViewItem>
            <NavigationViewItem x:Name="LogsNavigation" Content="Logs" Tag="Logs" AccessKey="L" ToolTipService.ToolTip="Logs (Ctrl+Shift+L)" AutomationProperties.AutomationId="NavigateLogs"><NavigationViewItem.Icon><SymbolIcon Symbol="List" /></NavigationViewItem.Icon></NavigationViewItem>
         </NavigationView.MenuItems>
         <Grid Padding="28,20,28,16" RowSpacing="16">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <Grid ColumnSpacing="16">
               <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
               <StackPanel Spacing="4"><TextBlock x:Name="PageTitle" Text="Printers" Style="{ThemeResource TitleTextBlockStyle}" /><TextBlock x:Name="PageDescription" Text="Choose which printers this computer shares with the server." Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" /></StackPanel>
               <Button x:Name="RefreshButton" Grid.Column="1" Click="Refresh_Click" AutomationProperties.AutomationId="RefreshStatus" VerticalAlignment="Center" ToolTipService.ToolTip="Refresh device status"><StackPanel Orientation="Horizontal" Spacing="8"><SymbolIcon Symbol="Refresh" /><TextBlock Text="Refresh" /></StackPanel></Button>
            </Grid>
            <InfoBar AutomationProperties.LiveSetting="Polite" x:Name="FeedbackBar" Grid.Row="1" IsOpen="False" IsClosable="True" />
            <Grid Grid.Row="2">
               <Grid x:Name="PrintersPage" RowSpacing="10">
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="PrintersSummary" Text="Waiting for the local print service" TextWrapping="Wrap" VerticalAlignment="Center" /><Button Grid.Column="1" Content="Windows printer settings" Click="PrinterSettings_Click" AutomationProperties.AutomationId="WindowsPrinterSettings" /></Grid>
                  <Grid Grid.Row="1" ColumnSpacing="12" Margin="8,0,24,0" AutomationProperties.AutomationId="PrinterTableHeader"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="64" /><ColumnDefinition Width="76" /></Grid.ColumnDefinitions><Button x:Name="PrinterNameHeader" Grid.Column="0" Style="{StaticResource TableHeaderButton}" Content="Name ↑" Tag="name" Click="PrinterSort_Click" AutomationProperties.AutomationId="SortPrinterName" AutomationProperties.Name="Sort by name, ascending" /><Button x:Name="PrinterStatusHeader" Grid.Column="1" Style="{StaticResource TableHeaderButton}" Content="Status" Tag="status" Click="PrinterSort_Click" AutomationProperties.AutomationId="SortPrinterStatus" AutomationProperties.Name="Sort by status" /><Button x:Name="PrinterLocationHeader" Grid.Column="2" Style="{StaticResource TableHeaderButton}" Content="Location" Tag="location" Click="PrinterSort_Click" AutomationProperties.AutomationId="SortPrinterLocation" AutomationProperties.Name="Sort by location" /><Button x:Name="PrinterFormatsHeader" Grid.Column="3" Style="{StaticResource TableHeaderButton}" Content="Formats" Tag="formats" Click="PrinterSort_Click" AutomationProperties.AutomationId="SortPrinterFormats" AutomationProperties.Name="Sort by formats" /><Button x:Name="PrinterSharedHeader" Grid.Column="4" Style="{StaticResource TableHeaderButton}" Content="Shared" Tag="shared" Click="PrinterSort_Click" AutomationProperties.AutomationId="SortPrinterShared" AutomationProperties.Name="Sort by shared" /></Grid>
                  <ListView x:Name="PrintersList" Grid.Row="2" ItemContainerStyle="{StaticResource FullWidthListItem}" SelectionMode="Single" SelectionChanged="PrinterSelection_Changed" DoubleTapped="Printers_DoubleTapped" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="PrinterInventory" />
                  <StackPanel x:Name="PrintersEmpty" Grid.Row="2" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="350"><TextBlock Text="Your printers will appear here" Style="{ThemeResource SubtitleTextBlockStyle}" TextAlignment="Center" TextWrapping="Wrap" /><TextBlock x:Name="PrintersEmptyText" Text="Install and start the local print service to discover printers." TextAlignment="Center" TextWrapping="Wrap" /><Button Content="Connection settings" Click="Connection_Click" HorizontalAlignment="Center" /></StackPanel>
                  <TextBlock Grid.Row="3" Text="Select a printer to expand its information. Double-click to open Settings. Shared printers also need server approval." TextWrapping="Wrap" FontSize="12" />
               </Grid>
               <Grid x:Name="JobsPage" Visibility="Collapsed" RowSpacing="10">
                  <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                  <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBox x:Name="JobSearch" MaxLength="256" AutomationProperties.AutomationId="JobSearch" PlaceholderText="Search the start of a job ID, title or printer name" AutomationProperties.Name="Search print history by prefix" TextChanged="JobFilters_Changed" /><ComboBox x:Name="JobStatusFilter" AutomationProperties.AutomationId="JobStatusFilter" Grid.Column="1" MinWidth="160" SelectedIndex="0" SelectionChanged="JobFilters_Changed" AutomationProperties.Name="Filter jobs by status"><ComboBoxItem Content="All states" Tag="ALL" /><ComboBoxItem Content="Needs attention" Tag="ATTENTION" /><ComboBoxItem Content="Queued" Tag="QUEUED" /><ComboBoxItem Content="Received" Tag="RECEIVED" /><ComboBoxItem Content="Sending" Tag="SUBMITTING" /><ComboBoxItem Content="Sent to printer" Tag="SPOOLED" /><ComboBoxItem Content="Failed" Tag="FAILED" /><ComboBoxItem Content="Outcome unknown" Tag="OUTCOME_UNKNOWN" /><ComboBoxItem Content="Windows completed" Tag="SPOOLER_COMPLETED" /></ComboBox></Grid>
                  <Grid Grid.Row="1" ColumnSpacing="12" Margin="8,0,24,0" AutomationProperties.AutomationId="JobTableHeader"><Grid.ColumnDefinitions><ColumnDefinition Width="2*" /><ColumnDefinition Width="1.4*" /><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="52" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions><Button x:Name="JobTitleHeader" Grid.Column="0" Style="{StaticResource TableHeaderButton}" Content="Document" Tag="title" Click="JobSort_Click" AutomationProperties.AutomationId="SortJobTitle" AutomationProperties.Name="Sort by document" /><Button x:Name="JobPrinterHeader" Grid.Column="1" Style="{StaticResource TableHeaderButton}" Content="Printer" Tag="printerName" Click="JobSort_Click" AutomationProperties.AutomationId="SortJobPrinter" AutomationProperties.Name="Sort by printer" /><Button x:Name="JobStatusHeader" Grid.Column="2" Style="{StaticResource TableHeaderButton}" Content="Status" Tag="status" Click="JobSort_Click" AutomationProperties.AutomationId="SortJobStatus" AutomationProperties.Name="Sort by status" /><Button x:Name="JobFormatHeader" Grid.Column="3" Style="{StaticResource TableHeaderButton}" Content="Format" Tag="format" Click="JobSort_Click" AutomationProperties.AutomationId="SortJobFormat" AutomationProperties.Name="Sort by format" /><Button x:Name="JobCreatedHeader" Grid.Column="4" Style="{StaticResource TableHeaderButton}" Content="Created ↓" Tag="createdAt" Click="JobSort_Click" AutomationProperties.AutomationId="SortJobCreated" AutomationProperties.Name="Sort by created, descending" /></Grid>
                  <ListView x:Name="JobsList" Grid.Row="2" ItemContainerStyle="{StaticResource FullWidthListItem}" SelectionMode="Single" SelectionChanged="JobSelection_Changed" DoubleTapped="Jobs_DoubleTapped" HorizontalContentAlignment="Stretch" AutomationProperties.AutomationId="RecentJobs" />
                  <StackPanel x:Name="JobsEmpty" Grid.Row="2" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="350"><TextBlock x:Name="JobsEmptyTitle" Text="No jobs yet" Style="{ThemeResource SubtitleTextBlockStyle}" HorizontalAlignment="Center" /><TextBlock x:Name="JobsEmptyMessage" Text="History will appear when the service receives jobs." TextWrapping="Wrap" TextAlignment="Center" /></StackPanel>
                  <Grid Grid.Row="3" ColumnSpacing="8"><Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><TextBlock x:Name="JobsSummary" AutomationProperties.AutomationId="JobsSummary" Text="Waiting for history" TextWrapping="Wrap" VerticalAlignment="Center" /><Button x:Name="JobsPrevious" Grid.Column="1" Content="Previous" Click="PreviousJobs_Click" IsEnabled="False" AutomationProperties.AutomationId="PreviousJobPage" /><Button x:Name="JobsNext" Grid.Column="2" Content="Next" Click="NextJobs_Click" IsEnabled="False" AutomationProperties.AutomationId="NextJobPage" /></Grid>
                  <StackPanel Grid.Row="4" Spacing="8"><TextBlock x:Name="SelectedJobText" Text="Select a job for details and actions." TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" /><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="JobDetailsButton" Content="Details" Click="JobDetails_Click" IsEnabled="False" AutomationProperties.AutomationId="JobDetails" /><Button x:Name="JobRetryButton" Content="Print again" Click="JobRetry_Click" IsEnabled="False" /><Button x:Name="JobCancelButton" Content="Cancel job" Click="JobCancel_Click" IsEnabled="False" /><Button x:Name="JobReviewButton" Content="Mark reviewed" Click="JobReview_Click" IsEnabled="False" /></StackPanel><TextBlock x:Name="JobsNotice" Text="Sent to printer means Windows accepted the job. Check the printer to confirm physical output." FontSize="12" TextWrapping="Wrap" /></StackPanel>
               </Grid>
               <StackPanel x:Name="LogsPage" Visibility="Collapsed" Spacing="16" MaxWidth="580" HorizontalAlignment="Left">
                  <TextBlock Text="Service and companion events are available together in the AppKit activity log." TextWrapping="Wrap" />
                  <Button Content="Open activity log" Click="ActivityLog_Click" AutomationProperties.AutomationId="ActivityLogMenuItem"><Button.Style><StaticResource ResourceKey="AccentButtonStyle" /></Button.Style></Button>
                  <TextBlock Text="Follow live updates, show errors only, copy entries or open the logs folder using the viewer’s toolbar." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                  <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Log settings" Click="LogSettings_Click" AutomationProperties.AutomationId="LogSettings" /><Button Content="Clear local logs" Click="ClearLogs_Click" AutomationProperties.AutomationId="ClearLogs" /></StackPanel>
                  <TextBlock Text="Logs rotate daily with bounded size and retention. Clearing diagnostic logs does not remove job history." TextWrapping="Wrap" />
               </StackPanel>
               <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                  <StackPanel Spacing="24" MaxWidth="680" HorizontalAlignment="Left">
                     <StackPanel Spacing="10"><TextBlock Text="Computer details" Style="{ThemeResource SubtitleTextBlockStyle}" /><TextBlock x:Name="DeviceProfileText" Text="Waiting for computer details" TextWrapping="Wrap" IsTextSelectionEnabled="True" /><Button Content="Edit computer details" Click="EditDevice_Click" AutomationProperties.AutomationId="EditDeviceProfile" /></StackPanel>
                     <StackPanel Spacing="10">
                        <TextBlock Text="Windows service" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="ServiceStateText" Text="Checking service installation…" />
                        <TextBlock x:Name="ServiceGuidanceText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                        <StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="StartServiceButton" AutomationProperties.AutomationId="StartService" Content="Start service" Click="StartService_Click" IsEnabled="False" /><Button x:Name="RestartServiceButton" AutomationProperties.AutomationId="RestartService" Content="Restart service" Click="RestartService_Click" IsEnabled="False" /><Button Content="Windows Services" Click="Services_Click" /></StackPanel>
                        <HyperlinkButton Content="Get the installer" NavigateUri="https://github.com/QRun-IO/qqq-print-agent/releases" Padding="0" />
                     </StackPanel>
                     <StackPanel Spacing="10"><TextBlock Text="Server connection" Style="{ThemeResource SubtitleTextBlockStyle}" /><TextBlock x:Name="StatusText" Text="Waiting for service status" TextWrapping="Wrap" AutomationProperties.AutomationId="ServiceStatus" /><TextBlock x:Name="ConnectionText" Text="Connect this computer to your print server." TextWrapping="Wrap" IsTextSelectionEnabled="True" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock x:Name="AuthenticationText" Text="Sign in to QQQ to enable printing." TextWrapping="Wrap" AutomationProperties.AutomationId="QqqAuthenticationStatus" /><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="ConnectionButton" Content="Sign in / Connection settings" Click="Connection_Click" AutomationProperties.AutomationId="ConnectionSettings" /><Button Content="Sign out" Click="SignOut_Click" AutomationProperties.AutomationId="QqqSignOut" /></StackPanel></StackPanel>
                     <StackPanel Spacing="10"><TextBlock Text="Diagnostic logs" Style="{ThemeResource SubtitleTextBlockStyle}" /><TextBlock Text="Service and companion logs rotate daily. Set retention and the daily size limit, inspect usage, or clear retained diagnostic logs." TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Log settings" Click="LogSettings_Click" AutomationProperties.AutomationId="SettingsLogSettings" /><Button Content="Clear local logs" Click="ClearLogs_Click" AutomationProperties.AutomationId="SettingsClearLogs" /></StackPanel></StackPanel>
                     <StackPanel Spacing="12"><TextBlock Text="Appearance" Style="{ThemeResource SubtitleTextBlockStyle}" /><ComboBox x:Name="ThemeChoice" Header="App theme" MinWidth="220" SelectionChanged="Theme_SelectionChanged"><ComboBoxItem Content="Use Windows setting" Tag="System" /><ComboBoxItem Content="Light" Tag="Light" /><ComboBoxItem Content="Dark" Tag="Dark" AutomationProperties.AutomationId="ThemeDark" /></ComboBox><ToggleSwitch x:Name="SplashToggle" Header="Show splash screen at startup" Toggled="Splash_Toggled" AutomationProperties.AutomationId="SplashAtStartup" /><NumberBox x:Name="SplashDuration" Header="Splash duration (milliseconds)" SpinButtonPlacementMode="Inline" SmallChange="500" LargeChange="1000" ValueChanged="SplashDuration_ValueChanged" AutomationProperties.AutomationId="SplashDuration" MinWidth="220" HorizontalAlignment="Left" /></StackPanel>
                     <StackPanel Spacing="10">
                        <TextBlock Text="Updates" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="VersionText" AutomationProperties.AutomationId="InstalledVersion" IsTextSelectionEnabled="True" />
                        <TextBlock x:Name="UpdateChannelText" AutomationProperties.AutomationId="UpdateChannel" />
                        <ToggleSwitch x:Name="UpdateStartupToggle" Header="Check for updates when the companion starts" Toggled="UpdateStartup_Toggled" AutomationProperties.AutomationId="CheckUpdatesAtStartup" />
                        <Button x:Name="CheckUpdatesButton" Content="Check for updates" Click="CheckUpdates_Click" AutomationProperties.AutomationId="CheckForUpdates" AccessKey="U" />
                        <TextBlock x:Name="UpdateStatusText" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" AutomationProperties.LiveSetting="Polite" />
                        <TextBlock x:Name="LastUpdateOutcomeText" Visibility="Collapsed" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="LastUpdateOutcome" AutomationProperties.LiveSetting="Polite" />
                        <HyperlinkButton Content="Release notes and downloads" NavigateUri="https://github.com/QRun-IO/qqq-print-agent/releases" Padding="0" AutomationProperties.AutomationId="ReleaseNotes" />
                     </StackPanel>
                     <StackPanel Spacing="10"><TextBlock Text="About and help" Style="{ThemeResource SubtitleTextBlockStyle}" /><Image x:Name="CustomerLogo" Visibility="Collapsed" Width="128" Height="64" Stretch="Uniform" HorizontalAlignment="Left" /><TextBlock x:Name="CompanyHeading" Visibility="Collapsed" TextWrapping="Wrap" /><HyperlinkButton x:Name="SupportLink" Content="Contact support" Visibility="Collapsed" Padding="0" /><Button x:Name="AboutButton" Content="About Print Agent" Click="About_Click" AutomationProperties.AutomationId="AboutMenuItem" /><HyperlinkButton Content="User guide" NavigateUri="https://github.com/QRun-IO/qqq-print-agent/blob/main/docs/USER-GUIDE.md" Padding="0" AutomationProperties.AutomationId="UserGuide" /><HyperlinkButton Content="Report an issue" NavigateUri="https://github.com/QRun-IO/qqq-print-agent/issues/new/choose" Padding="0" AutomationProperties.AutomationId="ReportIssue" /><HyperlinkButton Content="Project on GitHub" NavigateUri="https://github.com/QRun-IO/qqq-print-agent" Padding="0" AutomationProperties.AutomationId="ProjectLink" /></StackPanel>
                     <StackPanel Spacing="10"><TextBlock Text="Background printing" Style="{ThemeResource SubtitleTextBlockStyle}" /><ToggleSwitch x:Name="StartupToggle" Header="Show the tray companion when I sign in" IsEnabled="False" Toggled="Startup_Toggled" AutomationProperties.AutomationId="StartupAtSignIn" /><TextBlock x:Name="StartupGuidanceText" Text="Startup is off until you enable it for an installed copy." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><TextBlock Text="Closing this window keeps the companion in your tray. Printing continues in the Windows service, even when you exit the companion." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /><Button Content="Exit companion" Click="Exit_Click" /></StackPanel>
                  </StackPanel>
               </ScrollViewer>
            </Grid>
         </Grid>
      </NavigationView>
      <Border Grid.Row="2" Padding="20,10" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
         <Grid ColumnSpacing="12"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Ellipse x:Name="FooterDot" Width="10" Height="10" Fill="Red" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="2"><TextBlock x:Name="FooterStatus" Text="Checking local service…" FontWeight="SemiBold" TextWrapping="Wrap" AutomationProperties.AutomationId="FooterStatus" AutomationProperties.LiveSetting="Polite" /><TextBlock x:Name="FooterContact" Text="Status refreshes every 5 seconds" FontSize="12" TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" /></StackPanel><StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><Button x:Name="ReconnectButton" Content="Reconnect" Click="Reconnect_Click" AutomationProperties.AutomationId="ReconnectDevice" /><Button Content="View logs" Click="ServiceLogs_Click" AutomationProperties.AutomationId="ViewServiceLogs" /></StackPanel></Grid>
      </Border>
      <ContentDialog x:Name="ConnectionDialog" Title="Connection settings" CloseButtonText="Close" Closing="ConnectionDialog_Closing">
         <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="650"><StackPanel Spacing="12"><TextBlock Text="Sign in using this QQQ server's configured authentication. Printing uses your current permissions. Existing pairing and history are preserved." TextWrapping="Wrap" /><TextBox x:Name="ServerBox" Header="QQQ server address" PlaceholderText="https://print.example.com" AutomationProperties.AutomationId="ServerAddress" /><Button Content="Discover sign-in options" Click="DiscoverSignIn_Click" AutomationProperties.AutomationId="DiscoverQqqSignIn" /><StackPanel x:Name="PasswordSignInPanel" Spacing="8" Visibility="Collapsed"><TextBox x:Name="UsernameBox" Header="QQQ username" AutomationProperties.AutomationId="QqqUsername" /><PasswordBox x:Name="QqqPasswordBox" Header="QQQ password" AutomationProperties.AutomationId="QqqPassword" /><Button Content="Sign in" Click="PasswordSignIn_Click" AutomationProperties.AutomationId="QqqPasswordSignIn" /></StackPanel><Button x:Name="BrowserSignInButton" Content="Sign in with your browser" Visibility="Collapsed" Click="BrowserSignIn_Click" AutomationProperties.AutomationId="QqqBrowserSignIn" /><Button x:Name="CancelBrowserSignInButton" Content="Cancel browser sign-in" Visibility="Collapsed" Click="CancelBrowserSignIn_Click" AutomationProperties.AutomationId="CancelQqqSignIn" /><CheckBox x:Name="ClaimExistingDevice" Content="Associate this computer's existing pairing with my QQQ account" /><TextBlock Text="For a new connection, after signing in, create a single-use enrollment code in QQQ: Printing → Print devices → Actions → Enroll a print device." TextWrapping="Wrap" /><PasswordBox x:Name="EnrollmentBox" Header="Enrollment code (new pairing only)" PlaceholderText="Paste the code from the server" AutomationProperties.AutomationId="EnrollmentCode" /><Button x:Name="EnrollButton" Content="Connect this device" Click="Enroll_Click" Style="{ThemeResource AccentButtonStyle}" AutomationProperties.AutomationId="EnrollDevice" /><InfoBar x:Name="ConnectionFeedback" IsOpen="False" IsClosable="False" /></StackPanel></ScrollViewer>
      </ContentDialog>
   </Grid>
</Window>
