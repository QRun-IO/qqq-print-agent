<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Qqq.PrintAgent.MainWindow"
   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
   <Window.SystemBackdrop><MicaBackdrop /></Window.SystemBackdrop>
   <Grid x:Name="RootGrid" Loaded="Root_Loaded">
      <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
      <MenuBar>
         <MenuBarItem Title="File"><MenuFlyoutItem Text="Hide to tray" Click="Hide_Click" /><MenuFlyoutItem Text="Exit companion" Click="Exit_Click" /></MenuBarItem>
         <MenuBarItem Title="View">
            <RadioMenuFlyoutItem x:Name="ThemeSystem" Text="System theme" GroupName="Theme" Tag="System" Click="Theme_Click" />
            <RadioMenuFlyoutItem x:Name="ThemeLight" Text="Light theme" GroupName="Theme" Tag="Light" Click="Theme_Click" />
            <RadioMenuFlyoutItem x:Name="ThemeDark" Text="Dark theme" GroupName="Theme" Tag="Dark" Click="Theme_Click" AutomationProperties.AutomationId="ThemeDark" />
            <MenuFlyoutSeparator />
            <ToggleMenuFlyoutItem x:Name="SplashToggle" Text="Show splash at startup" Click="Splash_Click" />
         </MenuBarItem>
         <MenuBarItem Title="Help">
            <MenuFlyoutItem Text="Activity log" Click="ActivityLog_Click" AutomationProperties.AutomationId="ActivityLogMenuItem" />
            <MenuFlyoutItem Text="About QQQ Print Agent" Click="About_Click" AutomationProperties.AutomationId="AboutMenuItem" />
         </MenuBarItem>
      </MenuBar>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
         <StackPanel Spacing="20" Padding="32" MaxWidth="900" HorizontalAlignment="Stretch">
            <StackPanel Spacing="6">
               <TextBlock Text="QQQ Print Agent" Style="{ThemeResource TitleTextBlockStyle}" />
               <TextBlock Text="Connect this facility’s printers to QQQ." TextWrapping="Wrap" />
               <TextBlock Text="Close this window to keep status in your system tray. Printing continues in the Windows service." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
               <StackPanel Orientation="Horizontal" Spacing="10">
                  <Ellipse x:Name="HealthDot" Width="16" Height="16" Fill="Red" />
                  <TextBlock x:Name="HealthText" Text="Red — service not connected" FontWeight="SemiBold" AutomationProperties.AutomationId="AgentHealth" />
               </StackPanel>
            </StackPanel>
            <InfoBar x:Name="FeedbackBar" IsOpen="True" IsClosable="False" Severity="Informational" Title="Checking service" Message="Contacting the local print service…" />
            <Expander Header="Connection settings" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <StackPanel Spacing="10">
               <TextBlock Text="Connect to QQQ" Style="{ThemeResource SubtitleTextBlockStyle}" />
               <TextBlock Text="In QQQ, open Printing → Print devices → Actions → Enroll a print device. Enter the server address and the single-use enrollment code below." TextWrapping="Wrap" />
               <TextBox x:Name="ServerBox" Header="QQQ server address" PlaceholderText="https://qqq.example.com" AutomationProperties.AutomationId="ServerAddress" />
               <PasswordBox x:Name="EnrollmentBox" Header="Enrollment code" PlaceholderText="Paste the code from QQQ" AutomationProperties.AutomationId="EnrollmentCode" />
               <Button x:Name="EnrollButton" Content="Connect this device" Click="Enroll_Click" Style="{ThemeResource AccentButtonStyle}" AutomationProperties.AutomationId="EnrollDevice" />
            </StackPanel>
            </Expander>
            <StackPanel Spacing="10">
               <Grid>
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBlock Text="Service and printers" Style="{ThemeResource SubtitleTextBlockStyle}" VerticalAlignment="Center" />
                  <Button x:Name="RefreshButton" Grid.Column="1" Content="Refresh" Click="Refresh_Click" AutomationProperties.AutomationId="RefreshStatus" />
               </Grid>
               <TextBlock x:Name="StatusText" Text="Waiting for service status" TextWrapping="Wrap" AutomationProperties.AutomationId="ServiceStatus" />
               <TextBlock x:Name="ConnectionText" TextWrapping="Wrap" IsTextSelectionEnabled="True" />
               <TextBlock x:Name="PrintersSummary" Text="Printers visible to the service appear here." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
               <ListView x:Name="PrintersList" SelectionMode="None" MaxHeight="300" AutomationProperties.AutomationId="PrinterInventory" />
               <TextBlock Text="Only checked printers are exposed to QQQ. Enable them in QQQ after exposing them here. A submitted job is not confirmation of physical output." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Expander Header="Recent print jobs" IsExpanded="True" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
               <StackPanel Spacing="8"><TextBlock x:Name="JobsSummary" Text="No job information yet." /><ListView x:Name="JobsList" SelectionMode="None" MaxHeight="220" AutomationProperties.AutomationId="RecentJobs"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,5" /></DataTemplate></ListView.ItemTemplate></ListView></StackPanel>
            </Expander>
            <Expander Header="Service logs" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
               <StackPanel Spacing="8"><TextBlock Text="Recent service observations from this run. Credentials and document contents are excluded." TextWrapping="Wrap" /><ListView x:Name="ServiceLogsList" SelectionMode="None" MaxHeight="260" AutomationProperties.AutomationId="ServiceLogs"><ListView.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextWrapping="Wrap" IsTextSelectionEnabled="True" Margin="0,5" /></DataTemplate></ListView.ItemTemplate></ListView></StackPanel>
            </Expander>
            <TextBlock Text="Install updates using your organization’s approved installer or software management. The companion and service update together." TextWrapping="Wrap" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
         </StackPanel>
      </ScrollViewer>
   </Grid>
</Window>
