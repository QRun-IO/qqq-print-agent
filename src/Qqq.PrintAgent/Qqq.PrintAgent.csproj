<Project Sdk="Microsoft.NET.Sdk">

   <!-- The WinUI 3 shell: views, dialogs, and startup plumbing only; everything testable
        lives in Qqq.PrintAgent.Core. The companion ships with the service in a machine MSI. -->
   <PropertyGroup>
      <OutputType>WinExe</OutputType>
      <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
      <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
      <RootNamespace>Qqq.PrintAgent</RootNamespace>
      <ApplicationManifest>app.manifest</ApplicationManifest>
      <ApplicationIcon>Assets\Brand\app.ico</ApplicationIcon>
      <Platforms>x86;x64;ARM64</Platforms>
      <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
      <UseWinUI>true</UseWinUI>
      <WindowsPackageType>None</WindowsPackageType>
      <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
      <!-- The app supplies its WinUI startup entry point. -->
      <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
   </PropertyGroup>

   <ItemGroup>
      <!-- The splash and About render the SVG; the window and taskbar use the .ico. Both must
           reach the build and publish output, since the unpackaged app has no MSIX step. -->
      <Content Include="Assets\Brand\app-icon.svg" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="Assets\Brand\app.ico" CopyToOutputDirectory="PreserveNewest" />
      <Content Include="Assets\Brand\tray-*.png" CopyToOutputDirectory="PreserveNewest" />
      <Manifest Include="$(ApplicationManifest)" />
   </ItemGroup>

   <ItemGroup>
      <PackageReference Include="KofTwentyTwo.AppKit.WinUI" />
      <PackageReference Include="H.NotifyIcon.WinUI" />
      <PackageReference Include="Microsoft.WindowsAppSDK" />
      <PackageReference Include="Microsoft.Windows.SDK.BuildTools" PrivateAssets="all" />
   </ItemGroup>

   <ItemGroup>
      <Content Include="../../LICENSE;../../NOTICE" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
      <Content Include="../../licenses/**/*" Link="ThirdPartyNotices/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
   </ItemGroup>

   <ItemGroup>
      <ProjectReference Include="..\Qqq.PrintAgent.Core\Qqq.PrintAgent.Core.csproj" />
      <ProjectReference Include="..\Qqq.PrintAgent.Windows\Qqq.PrintAgent.Windows.csproj" />
   </ItemGroup>

   <ItemGroup>
      <!-- The app's own namespaces are global usings: their sort position against other
           usings depends on the app's name, which the template replaces. -->
      <Using Include="Qqq.PrintAgent.Core" />
   </ItemGroup>

   <!-- Unpackaged dotnet publish must carry the generated WinUI resource index and
        compiled XAML. These build outputs are not included by this SDK's publish items. -->
   <Target Name="PublishWinUIResources" AfterTargets="ComputeFilesToPublish">
      <Error Condition="!Exists('$(TargetDir)$(AssemblyName).pri')" Text="The WinUI application resource index was not generated." />
      <Error Condition="!Exists('$(TargetDir)MainWindow.xbf')" Text="The WinUI window markup was not generated." />
      <ItemGroup>
         <ResolvedFileToPublish Include="$(TargetDir)$(AssemblyName).pri">
            <RelativePath>$(AssemblyName).pri</RelativePath>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
         </ResolvedFileToPublish>
         <_WinUICompiledXaml Include="$(TargetDir)**\*.xbf" />
         <ResolvedFileToPublish Include="@(_WinUICompiledXaml)">
            <RelativePath>%(_WinUICompiledXaml.RecursiveDir)%(_WinUICompiledXaml.Filename)%(_WinUICompiledXaml.Extension)</RelativePath>
            <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
         </ResolvedFileToPublish>
      </ItemGroup>
   </Target>

</Project>
