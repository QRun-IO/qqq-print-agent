<?xml version="1.0" encoding="utf-8"?>
<!-- Packages come only from nuget.org (K22-DEP-10). Package source mapping makes the
     source explicit for every package id, so a same-named package on another feed can
     never be picked up (dependency confusion). -->
<configuration>
   <packageSources>
      <clear />
      <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
   </packageSources>
   <packageSourceMapping>
      <packageSource key="nuget.org">
         <package pattern="*" />
      </packageSource>
   </packageSourceMapping>
</configuration>
