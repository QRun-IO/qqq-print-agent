<Project Sdk="Microsoft.NET.Sdk">

   <!-- Unit tests for the companion's UI-free presentation assembly. They run in build/Verify.ps1 and
        feed the 100% line-coverage gate, so they use hand-written fakes, an injected clock and no real
        pipe, profile or registry. -->
   <PropertyGroup>
      <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
   </PropertyGroup>

   <ItemGroup>
      <PackageReference Include="coverlet.collector" />
      <PackageReference Include="Microsoft.NET.Test.Sdk" />
      <PackageReference Include="xunit" />
      <PackageReference Include="xunit.runner.visualstudio" />
   </ItemGroup>

   <ItemGroup>
      <Using Include="Xunit" />
   </ItemGroup>

   <ItemGroup>
      <ProjectReference Include="..\..\src\Qqq.PrintAgent.Presentation\Qqq.PrintAgent.Presentation.csproj" />
   </ItemGroup>

   <!-- The management contract's golden files belong to the Windows layer's suite, which holds them to the
        contract. They are linked here, not copied, so the companion's client is held to the same files. -->
   <ItemGroup>
      <Content Include="..\Qqq.PrintAgent.Cli.Tests\Fixtures\management\*.json" Link="Fixtures\management\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
   </ItemGroup>

   <!-- The view contract (Views\XamlContractTests.cs) reads the companion's markup and code-behind, and the two
        interactive suites that find controls by identifier, as text. They are copied beside the tests, never
        compiled and never referenced: this project must stay free of WinUI and of the companion (ArchitectureTests).
        IfDifferent, not PreserveNewest: a file put back to an earlier version is older than its copy and must still replace it. -->
   <ItemGroup>
      <ViewContractSource Include="..\..\src\Qqq.PrintAgent\**\*.xaml;..\..\src\Qqq.PrintAgent\**\*.cs" Exclude="..\..\src\Qqq.PrintAgent\bin\**;..\..\src\Qqq.PrintAgent\obj\**" Link="Companion\%(RecursiveDir)%(Filename)%(Extension)" />
      <ViewContractSource Include="..\Qqq.PrintAgent.UiTests\*.cs" Link="InteractiveTests\UiTests\%(Filename)%(Extension)" />
      <ViewContractSource Include="..\Qqq.PrintAgent.LayoutTests\*.cs" Link="InteractiveTests\LayoutTests\%(Filename)%(Extension)" />
      <Content Include="@(ViewContractSource)" CopyToOutputDirectory="IfDifferent" />
      <None Remove="Views\*.txt" />
      <Content Include="Views\*.txt" CopyToOutputDirectory="IfDifferent" />
   </ItemGroup>

   <!-- A copied file outlives its source in the output folder, so the tests read only the files this build names
        here: a view that was deleted or renamed is not read from an earlier build's copy. -->
   <Target Name="WriteViewContractSources" AfterTargets="CopyFilesToOutputDirectory">
      <WriteLinesToFile File="$(OutDir)view-contract-sources.txt" Lines="@(ViewContractSource->'%(Link)')" Overwrite="true" WriteOnlyWhenDifferent="true" />
   </Target>

</Project>
