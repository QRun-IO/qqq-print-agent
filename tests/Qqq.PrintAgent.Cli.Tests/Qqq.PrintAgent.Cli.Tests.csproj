<Project Sdk="Microsoft.NET.Sdk">

   <PropertyGroup>
      <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
   </PropertyGroup>

   <ItemGroup>
      <PackageReference Include="coverlet.collector" />
      <PackageReference Include="Microsoft.NET.Test.Sdk" />
      <PackageReference Include="xunit" />
      <PackageReference Include="xunit.runner.visualstudio" />
   </ItemGroup>

   <ItemGroup>
      <Using Include="Xunit" />
      <Compile Include="../Qqq.PrintAgent.Core.Tests/LoopbackWebSocketPeer.cs" Link="LoopbackWebSocketPeer.cs" />
      <Content Include="..\..\installer\Package.wxs" Link="Fixtures\Package.wxs" CopyToOutputDirectory="PreserveNewest" />
      <!-- The golden wire documents of the management contract: one request and one reply per operation, and one
           failure reply per error code that carries details. -->
      <None Remove="Fixtures\management\*.json" />
      <Content Include="Fixtures\management\*.json" CopyToOutputDirectory="PreserveNewest" />
   </ItemGroup>

   <ItemGroup>
      <ProjectReference Include="..\..\src\Qqq.PrintAgent.Cli\Qqq.PrintAgent.Cli.csproj" />
      <ProjectReference Include="..\Qqq.PrintAgent.WorkerFixture\Qqq.PrintAgent.WorkerFixture.csproj" />
   </ItemGroup>

   <Target Name="CopyWorkerFixtureRuntime" AfterTargets="Build">
      <ItemGroup>
         <WorkerFixtureAssembly Include="@(ReferenceCopyLocalPaths)" Condition="'%(Filename)' == 'Qqq.PrintAgent.WorkerFixture' And '%(Extension)' == '.dll'" />
         <WorkerFixtureRuntime Include="@(WorkerFixtureAssembly->'%(RootDir)%(Directory)%(Filename).exe')" />
         <WorkerFixtureRuntime Include="@(WorkerFixtureAssembly->'%(RootDir)%(Directory)%(Filename).runtimeconfig.json')" />
         <WorkerFixtureRuntime Include="@(WorkerFixtureAssembly->'%(RootDir)%(Directory)%(Filename).deps.json')" />
      </ItemGroup>
      <Error Condition="'@(WorkerFixtureAssembly)' == ''" Text="Worker fixture output was not resolved from the project reference." />
      <Copy SourceFiles="@(WorkerFixtureRuntime)" DestinationFolder="$(OutDir)" />
   </Target>
</Project>

