<Project Sdk="Microsoft.NET.Sdk">

   <PropertyGroup>
      <TargetFramework>net10.0</TargetFramework>
      <PrintingProtocolFixtures Condition="'$(PrintingProtocolFixtures)' == ''">$(MSBuildThisFileDirectory)../../../qqq-print-protocol/fixtures</PrintingProtocolFixtures>
   </PropertyGroup>

   <ItemGroup>
      <PackageReference Include="coverlet.collector" />
      <PackageReference Include="Microsoft.NET.Test.Sdk" />
      <PackageReference Include="xunit" />
      <PackageReference Include="xunit.runner.visualstudio" />
   </ItemGroup>

   <ItemGroup>
      <Using Include="Xunit" />
   </ItemGroup>

   <ItemGroup>
      <ProjectReference Include="..\..\src\Qqq.PrintAgent.Core\Qqq.PrintAgent.Core.csproj" />
   </ItemGroup>

   <ItemGroup>
      <!-- The app's own namespaces are global usings: their sort position against other
           usings depends on the app's name, which the template replaces. -->
      
   </ItemGroup>

   <ItemGroup>
      <Content Include="$(PrintingProtocolFixtures)/*.json" Link="fixtures/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
   </ItemGroup>
</Project>


